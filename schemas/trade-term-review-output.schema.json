{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inco.local/schemas/trade-term-review-output.schema.json",
  "title": "INCO Trade-Term Review Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "review_version",
    "rule_version",
    "status",
    "suitability",
    "confidence",
    "transaction_profile",
    "alignment_review",
    "responsibilities",
    "risks",
    "advantages",
    "disadvantages",
    "missing_information",
    "alternatives",
    "next_actions",
    "professional_boundary",
    "generated_at"
  ],
  "properties": {
    "review_id": {"type": "string"},
    "review_version": {"type": "string"},
    "rule_version": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "COMPLETE_WITH_WARNINGS", "CONDITIONAL_RESULT", "INSUFFICIENT_INFORMATION", "VALIDATION_ERROR", "STALE_RULE_BLOCKED"]
    },
    "suitability": {
      "type": "string",
      "enum": ["STRONG_FIT", "CONDITIONAL_FIT", "POOR_FIT", "INSUFFICIENT_INFORMATION"]
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "transaction_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_term", "perspective", "seller_country", "buyer_country", "transport_modes", "named_place", "intended_delivery_stage"],
      "properties": {
        "selected_term": {"type": "string"},
        "perspective": {"type": "string"},
        "seller_country": {"type": "string"},
        "buyer_country": {"type": "string"},
        "transport_modes": {"type": "array", "items": {"type": "string"}},
        "containerized": {"type": "string"},
        "named_place": {"type": ["string", "null"]},
        "intended_delivery_stage": {"type": "string"}
      }
    },
    "decision_summary_key": {"type": "string"},
    "alignment_review": {
      "type": "array",
      "items": {"$ref": "#/$defs/alignmentItem"}
    },
    "responsibilities": {
      "type": "array",
      "items": {"$ref": "#/$defs/responsibilityItem"}
    },
    "delivery_and_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_event_key", "risk_transfer_event_key", "cost_destination_key"],
      "properties": {
        "delivery_event_key": {"type": "string"},
        "risk_transfer_event_key": {"type": "string"},
        "cost_destination_key": {"type": "string"},
        "risk_cost_separation_warning": {"type": "boolean"}
      }
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "#/$defs/riskItem"}
    },
    "advantages": {
      "$ref": "#/$defs/partyPoints"
    },
    "disadvantages": {
      "$ref": "#/$defs/partyPoints"
    },
    "missing_information": {
      "type": "array",
      "items": {"$ref": "#/$defs/missingItem"}
    },
    "contradictions": {
      "type": "array",
      "items": {"$ref": "#/$defs/contradictionItem"},
      "default": []
    },
    "alternatives": {
      "type": "array",
      "items": {"$ref": "#/$defs/alternativeItem"}
    },
    "clarification_points": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "next_actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/actionItem"}
    },
    "professional_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_key", "specialist_confirmation_required"],
      "properties": {
        "message_key": {"type": "string"},
        "specialist_confirmation_required": {"type": "boolean"},
        "confirmation_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["contractual", "legal", "customs", "tax", "insurance", "carrier", "operational", "other"]
          },
          "default": []
        }
      }
    },
    "source_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "default": []
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "alignmentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "status", "explanation_key"],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "transport_compatibility",
            "named_place_clarity",
            "delivery_alignment",
            "responsibility_alignment",
            "risk_transfer_alignment",
            "cost_control_alignment",
            "operational_capability",
            "insurance_alignment",
            "clearance_exposure",
            "contract_clarity"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["ALIGNED", "CONDITIONAL", "MISALIGNED", "UNKNOWN"]
        },
        "explanation_key": {"type": "string"},
        "trigger_fields": {"type": "array", "items": {"type": "string"}},
        "required_action_keys": {"type": "array", "items": {"type": "string"}}
      }
    },
    "responsibilityItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity", "rule_party", "expected_party", "status"],
      "properties": {
        "activity": {"type": "string"},
        "rule_party": {"type": "string"},
        "expected_party": {"type": "string"},
        "status": {"type": "string", "enum": ["ALIGNED", "CONDITIONAL", "MISALIGNED", "UNKNOWN"]},
        "explanation_key": {"type": "string"}
      }
    },
    "riskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "risk_key", "severity", "affected_party", "trigger_fields", "why_it_matters_key", "mitigation_key"],
      "properties": {
        "risk_id": {"type": "string"},
        "risk_key": {"type": "string"},
        "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "information"]},
        "affected_party": {"type": "string", "enum": ["seller", "buyer", "both", "depends"]},
        "trigger_fields": {"type": "array", "items": {"type": "string"}},
        "why_it_matters_key": {"type": "string"},
        "mitigation_key": {"type": "string"},
        "visible_in_free_review": {"type": "boolean", "default": true}
      }
    },
    "partyPoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seller", "buyer"],
      "properties": {
        "seller": {"type": "array", "items": {"type": "string"}},
        "buyer": {"type": "array", "items": {"type": "string"}}
      }
    },
    "missingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "importance", "question_key", "blocks_definitive_result"],
      "properties": {
        "field_path": {"type": "string"},
        "importance": {"type": "string", "enum": ["critical", "material", "supporting"]},
        "question_key": {"type": "string"},
        "blocks_definitive_result": {"type": "boolean"}
      }
    },
    "contradictionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contradiction_key", "fields", "severity"],
      "properties": {
        "contradiction_key": {"type": "string"},
        "fields": {"type": "array", "items": {"type": "string"}},
        "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]}
      }
    },
    "alternativeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "reason_key", "seller_change_keys", "buyer_change_keys", "new_risk_keys"],
      "properties": {
        "term": {"type": "string"},
        "reason_key": {"type": "string"},
        "seller_change_keys": {"type": "array", "items": {"type": "string"}},
        "buyer_change_keys": {"type": "array", "items": {"type": "string"}},
        "new_risk_keys": {"type": "array", "items": {"type": "string"}},
        "free_review_visible": {"type": "boolean", "default": false}
      }
    },
    "actionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "action_key", "owner_party"],
      "properties": {
        "priority": {"type": "integer", "minimum": 1},
        "action_key": {"type": "string"},
        "owner_party": {"type": "string", "enum": ["seller", "buyer", "both", "internal_team", "specialist", "unknown"]},
        "blocking": {"type": "boolean", "default": false}
      }
    }
  }
}
